### 4. Example Consumption in a Java ViewModel

Because the services expose `LiveData` and `CompletableFuture`, a Java ViewModel interacts with them cleanly without any coroutines overhead:

```java
package edu.cnm.deepdive.skywatch.app.viewmodel;

import androidx.lifecycle.LiveData;
import androidx.lifecycle.MutableLiveData;
import androidx.lifecycle.ViewModel;
import dagger.hilt.android.lifecycle.HiltViewModel;
import edu.cnm.deepdive.skywatch.app.model.entity.Favorite;
import edu.cnm.deepdive.skywatch.app.model.entity.User;
import edu.cnm.deepdive.skywatch.app.service.FavoriteService;
import edu.cnm.deepdive.skywatch.app.service.UserService;
import jakarta.inject.Inject;
import java.util.List;

@HiltViewModel
public class UserFavoriteViewModel extends ViewModel {

    private final UserService userService;
    private final FavoriteService favoriteService;
    private final MutableLiveData<Throwable> throwable = new MutableLiveData<>();

    @Inject
    public UserFavoriteViewModel(UserService userService, FavoriteService favoriteService) {
        this.userService = userService;
        this.favoriteService = favoriteService;
    }

    public LiveData<User> getCurrentUser() {
        return userService.getCurrentUser();
    }

    public LiveData<List<Favorite>> getFavorites() {
        return favoriteService.getCurrentUserFavorites();
    }

    public void removeFavorite(Favorite favorite) {
        favoriteService.removeFavorite(favorite)
            .exceptionally(err -> {
                throwable.postValue(err);
                return null;
            });
    }

    public LiveData<Throwable> getThrowable() {
        return throwable;
    }
}
```

