### 3. Component Design & Recommendations

#### A. `UserRepository` (Data Access Abstraction)
Focuses strictly on Room queries and mutations for `User`.

```kotlin
package edu.cnm.deepdive.skywatch.app.repository

import androidx.lifecycle.LiveData
import edu.cnm.deepdive.skywatch.app.model.dao.UserDao
import edu.cnm.deepdive.skywatch.app.model.entity.User
import jakarta.inject.Inject
import jakarta.inject.Singleton
import java.net.URL
import kotlin.time.Clock

@Singleton
class UserRepository @Inject constructor(
    private val userDao: UserDao
) {

    fun get(id: Long): LiveData<User> = userDao.select(id)

    suspend fun getByOauthKey(oauthKey: String): User? = userDao.select(oauthKey)

    suspend fun save(user: User): User {
        return if (user.id == 0L) {
            val id = userDao.insert(user)
            user.copy(id = id)
        } else {
            userDao.update(user)
            user
        }
    }

    suspend fun delete(user: User) = userDao.delete(user)

    /**
     * Finds an existing user by OAuth key or creates a new record.
     */
    suspend fun getOrCreate(oauthKey: String, displayName: String, avatar: URL? = null): User {
        return userDao.select(oauthKey) ?: run {
            val newUser = User(
                oauthKey = oauthKey,
                displayName = displayName,
                avatar = avatar,
                created = Clock.System.now()
            )
            val id = userDao.insert(newUser)
            newUser.copy(id = id)
        }
    }
}
```

