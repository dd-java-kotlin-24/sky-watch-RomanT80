#### C. `FavoriteRepository` (Data Access Abstraction)
Interacts with `FavoriteDao` for persistent CRUD operations.

```kotlin
package edu.cnm.deepdive.skywatch.app.repository

import androidx.lifecycle.LiveData
import edu.cnm.deepdive.skywatch.app.model.dao.FavoriteDao
import edu.cnm.deepdive.skywatch.app.model.entity.Favorite
import jakarta.inject.Inject
import jakarta.inject.Singleton

@Singleton
class FavoriteRepository @Inject constructor(
    private val favoriteDao: FavoriteDao
) {

    fun getFavoritesByDescription(userId: Long): LiveData<List<Favorite>> =
        favoriteDao.selectOrderByDescription(userId)

    fun getFavoritesByFavorited(userId: Long): LiveData<List<Favorite>> =
        favoriteDao.selectOrderByFavorited(userId)

    suspend fun save(favorite: Favorite): Favorite {
        val id = favoriteDao.insert(favorite)
        return favorite.copy(id = id)
    }

    suspend fun delete(favorite: Favorite): Int =
        favoriteDao.delete(favorite)
}
```

